#!/bin/sh
# Checks working-tree formatting and README consistency. Full CI runs on push.
# Enable with `just hooks-install`.
set -e

echo "pre-commit: fmt-check + docs-check"

blocked() {
    echo ""
    echo "──────────────────────────────────────────────"
    echo " COMMIT BLOCKED — the fast gate failed."
    echo " Fix the failure above (\`just fmt\` for formatting), or bypass"
    echo " this one commit with:"
    echo "     git commit --no-verify"
    echo " The pre-push gate still runs 'just ci' on the commit."
    echo "──────────────────────────────────────────────"
    exit 1
}

cd "$(git rev-parse --show-toplevel)" || blocked

if ! command -v zig >/dev/null 2>&1; then
    echo "pre-commit: 'zig' is not on PATH; cannot check formatting."
    blocked
fi

# Check working-tree files here; pre-push validates committed snapshots.
zig fmt --check build.zig src examples tests bench scripts || blocked

if [ -f scripts/docs-check.sh ]; then
    bash scripts/docs-check.sh || blocked
else
    echo "pre-commit: scripts/docs-check.sh missing; cannot verify doc drift."
    blocked
fi

echo "pre-commit: passed."

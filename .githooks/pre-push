#!/bin/sh
# Local CI gate. Blocks a push unless every commit being pushed passes
# `just ci`, each checked out on its own in a temporary worktree.
# Enabled with `just hooks-install` (sets core.hooksPath=.githooks).
set -e

echo "──────────────────────────────────────────────"
echo " pre-push: running the local CI gate"
echo "──────────────────────────────────────────────"

blocked() {
    echo ""
    echo "──────────────────────────────────────────────"
    echo " PUSH BLOCKED — the local CI gate failed."
    echo " Fix the failure above, or bypass with:"
    echo "     git push --no-verify"
    echo "──────────────────────────────────────────────"
    exit 1
}

repo=$(git rev-parse --show-toplevel) || blocked
cd "$repo" || blocked

# The gate runs on the COMMIT being pushed, not on the working tree. Git names
# each ref on stdin as `<local-ref> <local-sha> <remote-ref> <remote-sha>`;
# each non-zero local sha is checked out detached into a temporary worktree
# and the gate runs there, so a dirty tree or a pushed side branch cannot make
# a green result mean something other than "this commit passes".
#
# Every exit path removes the worktree. `git worktree remove --force` is used
# because the gate leaves build output in it; `prune` afterwards drops the
# bookkeeping if the directory is already gone.
wt=""
cleanup() {
    if [ -n "$wt" ]; then
        git worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
        git worktree prune >/dev/null 2>&1 || true
        wt=""
    fi
}
trap cleanup EXIT INT TERM HUP

# The worktree gets a cold cache otherwise, which turns a few seconds of
# incremental work into a full rebuild in both optimize modes. Zig's cache is
# content-addressed, so sharing the main tree's is safe.
ZIG_LOCAL_CACHE_DIR="$repo/.zig-cache"
export ZIG_LOCAL_CACHE_DIR

# Runs the gate in the current directory: `just ci` when just is installed,
# otherwise the same steps by hand. A gate that green-lights because a tool
# is absent is worse than no gate at all.
run_gate() {
    if command -v just >/dev/null 2>&1; then
        just ci || return 1
        return 0
    fi
    echo "pre-push: 'just' not found; running the raw zig gate instead."
    if ! command -v zig >/dev/null 2>&1; then
        echo "pre-push: neither 'just' nor 'zig' is on PATH; cannot verify this push."
        return 1
    fi
    zig fmt --check build.zig src examples tests bench || return 1
    if [ -f scripts/docs-check.sh ]; then
        bash scripts/docs-check.sh || return 1
    else
        echo "pre-push: scripts/docs-check.sh missing in this commit; cannot verify doc drift."
        return 1
    fi
    zig build test || return 1
    zig build test -Doptimize=ReleaseSafe || return 1
    zig build || return 1
}

zero=$(printf '0%.0s' $(seq 1 40))
checked=""
gated=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    # A delete (`git push :branch`) pushes nothing; there is no tree to check.
    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: NOTE — $remote_ref is being deleted; nothing to verify."
        continue
    fi
    # Two refs at the same commit need one verdict.
    case " $checked " in
        *" $local_sha "*) continue ;;
    esac
    checked="$checked $local_sha"

    short=$(git rev-parse --short "$local_sha" 2>/dev/null || echo "$local_sha")
    echo ""
    echo "pre-push: gating $local_ref at $short"

    wt=$(mktemp -d "${TMPDIR:-/tmp}/claude_agent_zig-prepush.XXXXXX") || blocked
    git worktree add --detach "$wt" "$local_sha" >/dev/null 2>&1 || {
        echo "pre-push: could not check out $short into a temporary worktree."
        blocked
    }
    if (cd "$wt" && run_gate); then
        echo "pre-push: $short passed."
    else
        echo "pre-push: $short FAILED the gate."
        blocked
    fi
    cleanup
    gated=$((gated + 1))
done

if [ "$gated" -eq 0 ]; then
    echo "pre-push: no commits to gate."
fi
echo ""
echo "pre-push: local CI gate passed. Pushing."
